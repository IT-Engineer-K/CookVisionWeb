# このファイルを .env.local にコピーして値を入れてください。

# Supabase（Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 退会処理と動画βの利用枠の更新に使う管理用キー（Project Settings → API の service_role / secret key）
# サーバー側でだけ使う。NEXT_PUBLIC_ を付けない・GitHub に上げない
SUPABASE_SERVICE_ROLE_KEY=

# AI解析に使うサービス。今は gemini のみ対応（openai は今後追加）
AI_PROVIDER=gemini

# Gemini（Google AI Studio で発行）
GEMINI_API_KEY=
# 無料枠で使えるモデル。精度を上げたい場合は gemini-3.8-flash など
GEMINI_MODEL=gemini-3.1-flash-lite

# 動画解析β専用。課金を有効にしていない Gemini API プロジェクトのキーを設定する。
# 空欄のままならβは無効。写真解析のキー・モデル設定には影響しない。
VIDEO_BETA_GEMINI_API_KEY=

# Stripe（CookVision Plus 課金用。未設定でも他機能は動作）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLUS_PRICE_ID=
# 決済後の戻り先URL（ローカル開発時は http://localhost:3000）
NEXT_PUBLIC_APP_URL=
