# このファイルを .env.local にコピーして値を入れてください。

# Supabase（Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI解析に使うサービス。今は gemini のみ対応（openai は今後追加）
AI_PROVIDER=gemini

# Gemini（Google AI Studio で発行）
GEMINI_API_KEY=
# 無料枠で使えるモデル。精度を上げたい場合は gemini-3.8-flash など
GEMINI_MODEL=gemini-3.1-flash-lite
